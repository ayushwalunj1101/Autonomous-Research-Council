# ── LLM provider ─────────────────────────────────────────────────────────────
# openrouter (default when OPENROUTER_API_KEY is set) | groq | mock (offline, free) | replay
ARC_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model for every agent. Demo: anthropic/claude-sonnet-5.5 (~$0.10-0.15/run)
# Cheap development alternative: deepseek/deepseek-v3.2 (~$0.005/run)
ARC_MODEL=anthropic/claude-sonnet-5.5
# Per-agent overrides, e.g. a cheaper Fact-Checker:
# ARC_MODEL_FACT_CHECKER=deepseek/deepseek-v3.2
# ARC_MODEL_CHAIRMAN=anthropic/claude-sonnet-5.5

# Optional: Groq free tier (llama-3.3-70b-versatile) as provider or fallback
GROQ_API_KEY=your_groq_api_key_here
# ARC_LLM_FALLBACK=groq

# Hard cost limit per session in USD. A Sonnet 5.5 run costs ~$0.24 and each repair round ~$0.11;
# repairs are skipped once 75% of the limit is spent.
ARC_SESSION_BUDGET_USD=0.50

# ── Paper sources ────────────────────────────────────────────────────────────
# Leave empty unless you have a real key: placeholders are ignored.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: joins OpenAlex's faster "polite pool"
OPENALEX_MAILTO=
# Optional: raises the PubMed rate limit
NCBI_API_KEY=

# ── Council behaviour (defaults shown) ───────────────────────────────────────
# Claim checking: llm (supported/partial/unsupported/contradicted verdicts) | similarity (legacy thresholds)
# ARC_CLAIM_CHECK=llm
# Retry on RAGAS < 0.7: targeted (repair flagged claims) | full (re-run the whole debate, original method)
# ARC_RETRY_MODE=targeted
# Chaos constraint: llm (most relevant from the pool) | random
# ARC_CHAOS_SELECTION=llm
# Independent Chairman scoring passes (median + range shown in the report)
# ARC_SCORING_SAMPLES=3
# Let the Skeptic cite counter-evidence papers (1) instead of pure logic (0)
# ARC_SKEPTIC_EVIDENCE=0
# Debates that may run at once; others queue
# ARC_MAX_CONCURRENT_SESSIONS=2
# ARC_LLM_TIMEOUT=180
